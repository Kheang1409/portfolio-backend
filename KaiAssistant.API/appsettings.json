{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "EmailSettings": {
    "SmtpServer": "",
    "Port": 465,
    "SenderEmail": "",
    "ReceiverEmail": "",
    "SenderPassword": "",
    "Enabled": false
  },
  "GeminiSettings": {
    "ApiKey": "",
    "ModelNames": [
      "gemini-3.1-flash-lite-preview:generateContent",
      "gemini-3-flash-preview:generateContent",
      "gemini-2.5-flash:generateContent",
      "gemini-2.5-flash-lite:generateContent"
    ],
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/models/",
    "SystemPrompt": "You are Mr Taing's professional AI assistant. Represent Kheang professionally and help visitors learn about his background, skills, and experience.",
    "PromptMaxChars": 10000,
    "IncludePersonalDetails": true,
    "Temperature": 0.4,
    "TopK": 20,
    "TopP": 0.85,
    "MaxOutputTokens": 768,
    "CandidateCount": 1,
    "LastSuccessfulModelCacheTtlSeconds": 120,
    "SkipRetryDelayThresholdSeconds": 3,
    "DeprioritizeOn429Count": 1,
    "DeprioritizeSkip": true
  },
  "MongoDB": {
    "ConnectionString": "",
    "DatabaseName": ""
  },
  "Redis": {
    "ConnectionString": ""
  },
  "DistributedCache": {
    "KeyPrefix": "kaiassistant",
    "Namespace": "api",
    "DefaultTtlSeconds": 120,
    "TtlJitterSeconds": 15,
    "RebuildLockTimeoutMs": 5000
  },
  "FeatureFlags": {
    "EnableRabbitMqPublishing": false,
    "EnableOutboxProcessing": false,
    "EnableOutboxRecovery": false,
    "EnableAiResponseCache": false,
    "EnableAssistantBatching": false,
    "EnableCache": false,
    "EnableRateLimiting": true,
    "EnableStreaming": true,
    "EnableSemanticCaching": true,
    "EnableRag": true,
    "EnableConversationMemory": true,
    "PreferredAiProvider": "gemini"
  },
  "FeatureFlagStore": {
    "Enabled": true,
    "RefreshIntervalSeconds": 30
  },
  "AiOrchestration": {
    "PrimaryProvider": "gemini",
    "SecondaryProvider": "openai",
    "ProviderTimeoutMs": 15000,
    "DefaultMaxOutputTokens": 1024
  },
  "SemanticCache": {
    "Enabled": true,
    "SimilarityThreshold": 0.9,
    "EmbeddingDimensions": 64,
    "CacheTtlSeconds": 3600,
    "CandidateScanLimit": 300
  },
  "Rag": {
    "Enabled": true,
    "TopK": 5,
    "MinSimilarity": 0.7,
    "MaxContextChars": 4000,
    "CandidateCount": 20,
    "RerankedTopK": 6
    ,"SemanticCandidateCount": 20
    ,"KeywordCandidateCount": 20
    ,"FusionCandidateCount": 40
    ,"RrfK": 60
    ,"ContextChunkCount": 6
    ,"EnableReranking": false
    ,"MaxContextEstimatedTokens": 1000
    ,"MinimumEvidenceScore": 0.01
    ,"NearDuplicateThreshold": 0.85
    ,"PipelineVersion": "rag-v1"
    ,"IndexVersion": "knowledge-v1"
  },
  "Knowledge": {
    "CorpusPath": "rag-corpus",
    "SemanticIndexingEnabled": true,
    "ChunkSize": 1000,
    "ChunkOverlap": 150
  },
  "RagIngestion": {
    "MaxChunkChars": 1000,
    "ChunkOverlapChars": 150,
    "RetrievalCandidateCount": 20,
    "RerankedChunkCount": 6,
    "MaxFileSizeBytes": 5242880,
    "MaxConcurrency": 2,
    "PollingIntervalSeconds": 3,
    "LeaseDurationSeconds": 120,
    "MaxAttempts": 3,
    "RetryBaseDelaySeconds": 5,
    "AllowedMimeTypes": ["text/plain", "text/markdown", "application/json"]
  },
  "Embedding": {
    "Provider": "gemini",
    "Model": "gemini-embedding-001",
    "Dimensions": 768,
    "BatchSize": 20,
    "MaxConcurrency": 2,
    "RequestTimeoutSeconds": 20,
    "MaxRetries": 3,
    "MaxInputChars": 8000,
    "CacheEnabled": true,
    "QueryCacheTtlSeconds": 900,
    "DocumentCacheTtlSeconds": 86400,
    "Version": "gemini-001-768-v1",
    "IndexVersion": "knowledge-gemini-001-v2"
  },
  "Conversations": {
    "Enabled": true,
    "MaxMessages": 24,
    "ShortTermWindow": 10,
    "SummaryMaxChars": 1200
  },
  "AiEvaluation": {
    "MaxPromptsPerRun": 20
  },
  "AiStreaming": {
    "Enabled": true,
    "MaxStreamDurationSeconds": 45,
    "MaxTokensPerStream": 1600
  },
  "LoadTestHooks": {
    "Enabled": false
  },
  "RateLimiting": {
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "BurstMultiplier": 1,
    "GlobalPermitLimit": 1000,
    "StrictDistributedMode": false,
    "UseSlidingWindow": true,
    "PathPrefixes": ["/api"],
    "EndpointRules": [
      {
        "Name": "ask",
        "PathContains": "/ask",
        "PermitLimit": 120,
        "WindowSeconds": 60
      },
      {
        "Name": "stream",
        "PathContains": "/stream",
        "PermitLimit": 60,
        "WindowSeconds": 60
      },
      {
        "Name": "batch",
        "PathContains": "/batch",
        "PermitLimit": 30,
        "WindowSeconds": 60
      },
      {
        "Name": "sse",
        "PathContains": "/sse",
        "PermitLimit": 45,
        "WindowSeconds": 60
      }
    ]
  },
  "RequestHardening": {
    "MaxRequestBodySizeBytes": 262144
  },
  "Ops": {
    "EnabledInProduction": false,
    "SlowRequestThresholdMs": 800,
    "HighVolumeLogSampleRate": 0.2,
    "HighVolumePathPrefixes": ["/api/assistants/ask"]
  },
  "OpsSecurity": {
    "Enabled": false,
    "HeaderName": "X-Ops-Key",
    "ApiKey": "",
    "RequireJwt": false,
    "JwtAuthority": "",
    "JwtAudience": "",
    "AllowedIpRanges": []
  },
  "Outbox": {
    "Enabled": false,
    "BatchSize": 25,
    "PollIntervalSeconds": 5,
    "MaxBackoffSeconds": 300,
    "MaxConcurrency": 4,
    "RetryJitterMs": 250,
    "BackpressureDelayMs": 250,
    "LeaseDurationSeconds": 45,
    "MaxAttempts": 10,
    "PartitionCount": 1,
    "PartitionIndex": 0,
    "IdempotencyProcessedTtlSeconds": 86400,
    "IdempotencyProcessingTtlSeconds": 90
  },
  "OutboxRecovery": {
    "EnableReplayEndpoints": false,
    "MaxReplayBatchSize": 100
  },
  "AiGovernance": {
    "Enabled": false,
    "MaxTokensPerRequest": 1200,
    "MaxRequestsPerMinutePerIp": 20,
    "MaxInputChars": 3000,
    "MaxHistoryMessages": 8,
    "MaxHistoryMessageChars": 1200,
    "EstimatedCharsPerToken": 4,
    "TruncateOversizedInput": true,
    "EnableResponseCache": false,
    "ResponseCacheTtlSeconds": 45,
    "CacheKeyVersion": "v1",
    "EnableResponseTruncation": false,
    "MaxResponseChars": 2200,
    "MaxCostPerRequestUsd": 0.02,
    "SoftBudgetPerMinuteUsdPerIp": 0.2,
    "SoftBudgetPerHourUsdPerSession": 2.0,
    "MinimumResponseChars": 8,
    "EnableUnsafeOutputFiltering": true,
    "UnsafeTerms": []
  },
  "AiModelOrchestration": {
    "Enabled": true,
    "EnableTrafficSimulation": false,
    "EnableFailureSimulation": false,
    "FailureInjectionRate": 0.0,
    "SimulationRequestCount": 200,
    "EnableAutoTuning": false,
    "AutoTuneIntervalSeconds": 30,
    "MaxLatencyMs": 2500,
    "MaxCostPerMinute": 0.2,
    "DecisionAuditSampleRate": 0.1,
    "SimplePromptCharsThreshold": 500,
    "SimplePromptTokensThreshold": 400,
    "ComplexPromptCharsThreshold": 2000,
    "ComplexPromptTokensThreshold": 1500,
    "MaxFallbackModels": 3,
    "HealthTtlSeconds": 120,
    "ModelHealthStateRefreshSeconds": 10,
    "QuotaCooldownMinutes": 60,
    "MetricsRollingWindowMinutes": 30,
    "MetricsPersistIntervalSeconds": 15,
    "LatencyReferenceMs": 2500,
    "SuccessRateWeight": 1.4,
    "LatencyWeight": 0.8,
    "FailureRateWeight": 1.2,
    "CooldownWeight": 0.9,
    "CostWeight": 0.6,
    "DecisionCacheSeconds": 10,
    "MaxEstimatedCostPerRequestUsd": 0.05,
    "CircuitOpenSeconds": 30,
    "CircuitFailureThreshold": 5,
    "ModelProfiles": [
      {
        "Name": "gemini-2.5-flash:generateContent",
        "MaxTokens": 8192,
        "CostWeight": 0.8,
        "LatencyWeight": 0.6,
        "CapabilityScore": 0.55,
        "InputCostPer1KTokensUsd": 0.001,
        "OutputCostPer1KTokensUsd": 0.002,
        "Priority": 1,
        "Enabled": true
      }
    ]
  },
  "RabbitMq": {
    "Enabled": false,
    "HostName": "",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "kaiassistant.events",
    "RoutingKeyPrefix": "kaiassistant"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "AllowedHosts": "*"
}
