<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Ensure all resolved NuGet assemblies are copied to the test output folder so integration tests can find native/3rd-party deps -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.0" />
    <PackageReference Include="FluentAssertions" Version="6.9.0" />
    <PackageReference Include="Moq" Version="4.18.4" />
    <PackageReference Include="Mongo2Go" Version="4.0.0" />
    <!-- Ensure the test runner has the same MongoDB driver assembly available at runtime -->
    <PackageReference Include="MongoDB.Driver" Version="3.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KaiAssistant.API\KaiAssistant.API.csproj" />
    <ProjectReference Include="..\KaiAssistant.Application\KaiAssistant.Application.csproj" />
    <ProjectReference Include="..\KaiAssistant.Infrastructure\KaiAssistant.Infrastructure.csproj" />
    <ProjectReference Include="..\KaiAssistant.Domain\KaiAssistant.Domain.csproj" />
  </ItemGroup>
</Project>
